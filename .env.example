# Copy to .env only if you need to override the default. Never commit .env.

# XRPL Testnet endpoint. The scripts fall back to this value when unset.
XRPL_ENDPOINT=wss://s.altnet.rippletest.net:51233/

# There is no key variable here on purpose.
#
# Every run asks the Testnet faucet for a fresh funded wallet, so this project
# never stores a seed, a private key or any other credential - there is nothing
# in it that could leak through a commit or a screen recording.
